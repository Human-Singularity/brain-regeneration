# Cloudflare Pages — rewrite rules
# Serve the articles shell for any /articles/{id}/ path so that
# the client-side JS can extract the article ID and fetch from the API.
/articles/*  /articles/  200

# Serve the author profile shell for any /authors/{orcid}/ path so that
# the client-side JS can extract the ORCID and fetch from the API.
/authors/*  /authors/  200

# Serve the trial detail shell for any /trials/{id}/ path so that
# the client-side JS can extract the trial ID and fetch from the API.
/trials/*  /trials/  200

# Redirect bare condition pages to their clinical-trials subpage
/conditions/:condition/  /conditions/:condition/clinical-trials/  301

# Redirect old research-papers search URL to the new section root
/search/research-papers/  /search/  301
